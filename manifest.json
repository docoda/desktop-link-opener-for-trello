{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "1.0.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "docoda",
  "homepage_url": "https://github.com/docoda/desktop-link-opener-for-trello",
  "browser_specific_settings": {
    "gecko": {
      "id": "trello-desktop-opener@docoda.de",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "*://trello.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "__MSG_toggleTitleOn__"
  },
  "web_accessible_resources": [
    "redirect.html",
    "redirect.js"
  ]
}
